# Copy this file to terraform.tfvars and update values for your environment.
# Restrict cluster_endpoint_public_access_cidrs to your IP/CIDR for real deployments.

aws_region     = "us-east-1"
cluster_name   = "devops-cluster"
eks_version    = "1.32"

node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 1
node_max_size      = 3

ecr_repository_name = "devops-app"

# GitHub repository in the form owner/repo, used for OIDC condition
github_repository = "your-github-owner/final-devops-project"
# Replace with a trusted static egress IP/CIDR. This documentation-only address will not allow access.
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

tags = {
  Project        = "devops-final-project"
  Environment    = "production"
  ManagedBy      = "terraform"
}
